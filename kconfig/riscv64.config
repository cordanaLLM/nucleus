# Lusoris Hardened Baseline Configuration - riscv64
CONFIG_64BIT=y
CONFIG_RISCV=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64

# RANDOMIZE_BASE (security-hardened.config) depends on RELOCATABLE on riscv since Linux
# 7.2; before, it selected it. The riscv defconfig leaves RELOCATABLE unset.
CONFIG_RELOCATABLE=y

# Virtualization & Paravirtualization
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# Storage & Block Layer
CONFIG_BLK_DEV_NVME=y
# There is no CONFIG_DEFAULT_MQ_DEADLINE: when mq-deadline is built, block/elevator.c
# makes it the default for single-queue devices.
CONFIG_MQ_IOSCHED_DEADLINE=y

# Networking & Congestion Control
# TCP_CONG_BBR sits inside "if TCP_CONG_ADVANCED" (net/ipv4/Kconfig); only the x86_64
# defconfig sets it, so it is declared wherever BBR is.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_WIREGUARD=m

# Containers & eBPF
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y

# Security & LSM
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
