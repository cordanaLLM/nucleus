# Lusoris Hardened Baseline Configuration - arm64
CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=256

# Virtualization & Paravirtualization
CONFIG_KVM_GUEST=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_FS=y

# Storage & Block Layer
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_TCP=m
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_DEFAULT_MQ_DEADLINE=y

# Networking & Congestion Control
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_WIREGUARD=m

# Containers & eBPF
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_SCHED_CLASS_EXT=y

# Security & LSM
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
