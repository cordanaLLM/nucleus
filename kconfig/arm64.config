# Lusoris Hardened Baseline Configuration - arm64
CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=256

# In-kernel configuration: the kernel-config probe of a requirement document reads
# /proc/config.gz, which exists only when both symbols are set.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Virtualization & Paravirtualization
CONFIG_KVM_GUEST=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_FS=y

# Storage & Block Layer
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_TCP=m
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_DEFAULT_MQ_DEADLINE=y

# Networking & Congestion Control
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_WIREGUARD=m

# Containers & eBPF
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_SCHED_CLASS_EXT=y
# SCHED_CLASS_EXT depends on DEBUG_INFO_BTF, which sits inside "if DEBUG_INFO" and is
# refused under DEBUG_INFO_REDUCED (the arm64 defconfig sets it). DEBUG_INFO_DWARF5 selects
# DEBUG_INFO; its "Debug information" choice depends on DEBUG_KERNEL. BTF also depends on
# PAHOLE_VERSION >= 122, so the build host needs pahole 1.22 or newer.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF5=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y

# Security & LSM
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
