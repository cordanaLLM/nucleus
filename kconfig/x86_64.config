# Lusoris Hardened Baseline Configuration - x86_64
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=512

# In-kernel configuration: the kernel-config probe of a requirement document reads
# /proc/config.gz, which exists only when both symbols are set (IKCONFIG_PROC depends on
# IKCONFIG && PROC_FS).
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Virtualization & Paravirtualization
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
# VIRTIO_FS depends on FUSE_FS and is capped by it: the x86_64 defconfig leaves FUSE_FS
# unset and the arm64 defconfig builds it as a module.
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y

# Host virtualization & device passthrough
# CONFIG_KVM is the host hypervisor, not CONFIG_KVM_GUEST above: imago FLAVOR-BASE, Aegis REQ-BOOT-01.
# KVM runs no guest without a vendor backend, so both backends are built as modules with it.
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
# CONFIG_IOMMU_API has no prompt: VFIO and the vendor IOMMU drivers select it. The vendor
# drivers put devices into the IOMMU groups the iommu-groups probe reads; they and VFIO_PCI
# need PCI. imago FLAVOR-AI-INFER, Aegis REQ-P03-06.
CONFIG_PCI=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y
CONFIG_IOMMU_API=y
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m

# Storage & Block Layer
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_TCP=m
# There is no CONFIG_DEFAULT_MQ_DEADLINE: when mq-deadline is built, block/elevator.c
# makes it the default for single-queue devices.
CONFIG_MQ_IOSCHED_DEADLINE=y

# Networking & Congestion Control
# TCP_CONG_BBR sits inside "if TCP_CONG_ADVANCED" (net/ipv4/Kconfig); only the x86_64
# defconfig sets it, so it is declared wherever BBR is.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_WIREGUARD=m

# Containers & eBPF
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_CGROUP_BPF=y
# BTF in vmlinux for CO-RE eBPF, and for SCHED_CLASS_EXT above, which depends on it:
# imago FLAVOR-K8S-NODE, Aegis REQ-P06-05. DEBUG_INFO_BTF sits inside "if DEBUG_INFO";
# DEBUG_INFO_DWARF5 selects DEBUG_INFO, and its "Debug information" choice depends on
# DEBUG_KERNEL. Without DEBUG_KERNEL and a debug-info choice, olddefconfig drops BTF, and
# SCHED_CLASS_EXT with it. BTF also depends on PAHOLE_VERSION >= 122, so the build host
# needs pahole 1.22 or newer.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y

# Security & LSM
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# BPF LSM: Aegis REQ-P06-05, probed with lsm-list (/sys/kernel/security/lsm). BPF_LSM
# depends on BPF_SYSCALL, SECURITY and BPF_JIT, set above, and on BPF_EVENTS, which has no
# prompt and needs kprobe or uprobe events. It is active at boot only while "bpf" is in
# CONFIG_LSM, which security-hardened.config sets for every architecture.
CONFIG_BPF_LSM=y

# Power capping & telemetry: Aegis REQ-P13-02. INTEL_RAPL depends on PCI (set above) and
# selects INTEL_RAPL_CORE, which selects IOSF_MBI. Built-in drivers of the x86_64 defconfig
# (DRM_I915) select IOSF_MBI too, so it resolves built-in and is declared that way.
CONFIG_POWERCAP=y
CONFIG_IOSF_MBI=y
CONFIG_INTEL_RAPL=m
