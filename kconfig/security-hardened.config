# Lusoris Kernel Self-Protection Project (KSPP) Baseline
CONFIG_BUG=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y

# LSM initialization order. CONFIG_LSM is a string: once a base .config records one,
# olddefconfig keeps it even when DEFAULT_SECURITY_APPARMOR changes the default, so an
# arm64 or riscv64 defconfig base leaves AppArmor built but off the list, and inactive.
# Set here for every architecture. "bpf" activates BPF LSM where it is built (x86_64,
# Aegis REQ-P06-05); an LSM the list names but the kernel does not build is skipped.
CONFIG_LSM="landlock,lockdown,yama,apparmor,bpf"

# BPF trampolines: a BPF LSM program (Aegis REQ-P06-05) and every fentry, fexit and fmod_ret
# program attach through one. kernel/bpf/trampoline.c register_fentry() hands the attach to
# ftrace when the target function has an ftrace call site, and that needs
# DYNAMIC_FTRACE_WITH_DIRECT_CALLS; without FUNCTION_TRACER there is no call site, and the
# fallback, bpf_arch_text_poke(), refuses a kernel function: -EBUSY on x86_64 (no 5-byte nop
# to patch), -ENOTSUPP on arm64, -EFAULT on riscv64. BPF LSM then loads and cannot attach.
# FUNCTION_TRACER sits inside "if FTRACE", which the arm64 defconfig unsets; DYNAMIC_FTRACE
# keeps every call site a nop until something attaches. DIRECT_CALLS has no prompt: it follows
# DYNAMIC_FTRACE_WITH_REGS or _WITH_ARGS and the architecture's
# HAVE_DYNAMIC_FTRACE_WITH_DIRECT_CALLS, which x86 selects unconditionally, arm64 when
# DYNAMIC_FTRACE_WITH_ARGS (and, before 7.3, CALL_OPS) resolves, and riscv with CALL_OPS.
# Function tracing stays off at boot; tracefs is mode 0700, root only. docs/adr/0011.
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_DYNAMIC_FTRACE_WITH_DIRECT_CALLS=y

# zlib deflate for out-of-tree modules: OpenZFS refuses to configure without ZLIB_DEFLATE=y|m
# ("This kernel does not include the required zlib deflate support"). ZLIB_DEFLATE has no
# prompt; on an x86_64 defconfig base its only selector was DRM_I915_COMPRESS_ERROR, and
# DRM_I915 depends on !PREEMPT_RT, so the realtime stream lost it (Linux 7.2.10,
# drivers/gpu/drm/i915/Kconfig). CRYPTO_DEFLATE selects ZLIB_DEFLATE and ZLIB_INFLATE
# (crypto/Kconfig, the same in 6.18.56 and 7.3-rc7), so every stream and architecture carries it
# on its own. ZLIB_DEFLATE is requested too, though it has no prompt: the survival check
# (scripts/kconfig_survival.py) then refuses a leg on which nothing selects it. docs/streams.md.
CONFIG_CRYPTO_DEFLATE=y
CONFIG_ZLIB_DEFLATE=y

# Module signing after the build (issue #77). The build signs nothing and generates no key: it
# trusts the certificate that scripts/build_kernel.sh writes to
# certs/nucleus-module-signing.pem in the build directory (a key given with --module-key, or one
# generated for that build and deleted after it), and scripts/sign_kernel_modules.py signs every
# module in the image package after packaging and records the step. This is the method of the
# kernel's Documentation/kbuild/reproducible-builds.rst, "Module signing": a key generated inside
# the build differed per build and was the only difference between two builds of a leg.
# MODULE_SIG_FORCE stays off, as before: an unsigned module still loads and taints the kernel.
CONFIG_MODULE_SIG=y
# CONFIG_MODULE_SIG_ALL is not set
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_KEY=""
CONFIG_SYSTEM_TRUSTED_KEYS="certs/nucleus-module-signing.pem"
