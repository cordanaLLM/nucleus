# Lusoris Kubernetes Node Configuration - every stream, every architecture
#
# Merged after the architecture fragment and before the stream fragment
# (scripts/merge-config.sh). It builds what a Kubernetes node with a container runtime and the
# Cilium network plugin loads: imago FLAVOR-K8S-NODE. Every symbol here is also listed in
# kconfig/required-config.json, so a build in which one is off is refused.

# Container runtime: overlay image layers and network namespaces joined by veth pairs. User
# namespaces isolate pod users. Pressure stall information is read by the kubelet and cgroup v2.
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_OVERLAY_FS=m
CONFIG_VETH=m
CONFIG_PSI=y

# Cilium: VXLAN and Geneve tunnels, the tc ingress hook and the BPF classifier it attaches to
# (NET_CLS_ACT is the direct-action mode it uses), the socket diagnostics its agent reads.
CONFIG_VXLAN=m
CONFIG_GENEVE=m
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_SCH_FQ_CODEL=m
CONFIG_NET_CLS_BPF=m
CONFIG_NET_CLS_ACT=y
CONFIG_INET_DIAG=m
CONFIG_INET_UDP_DIAG=m

# Bridged pod networks and VLAN trunks. GVRP and MVRP select the garp and mrp modules.
CONFIG_BRIDGE=m
CONFIG_BRIDGE_NETFILTER=m
CONFIG_VLAN_8021Q=m
CONFIG_VLAN_8021Q_GVRP=y
CONFIG_VLAN_8021Q_MVRP=y

# Netfilter: nf_tables for kube-proxy and the runtime, ip_set and the xtables matches and
# targets of Cilium's iptables mode (socket match and TPROXY for its transparent proxy).
# Most of these sit inside "if NETFILTER_ADVANCED".
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NAT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_CT=m
CONFIG_NFT_MASQ=m
CONFIG_IP_SET=m
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_NET=m
# The legacy iptables raw table is in kconfig/streams/{bleeding,mainstream,lts}.config,
# since upstream makes it depend on !PREEMPT_RT.
CONFIG_NETFILTER_XT_SET=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m

# Encrypted volumes and network storage: dm-crypt and dm-thin need the device mapper, iSCSI
# volumes the transport class and TCP initiator. Local and network storage include XFS, ZRAM
# swap, and NBD. NVME_HOST_AUTH selects NVME_AUTH and NVME_KEYRING, built in with the NVMe
# core the architecture fragments build in.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=m
CONFIG_DM_THIN_PROVISIONING=m
CONFIG_SCSI_ISCSI_ATTRS=m
CONFIG_ISCSI_TCP=m
CONFIG_XFS_FS=m
CONFIG_BLK_DEV_NBD=m
CONFIG_NVME_HOST_AUTH=y

# Guest sockets to the hypervisor, userspace I/O for device plugins, device passthrough
# through iommufd, and the AF_ALG hash interface cryptsetup uses.
CONFIG_VSOCKETS=m
CONFIG_VSOCKETS_LOOPBACK=m
CONFIG_VIRTIO_VSOCKETS=m
CONFIG_QRTR=m
CONFIG_UIO=m
CONFIG_UIO_PCI_GENERIC=m
CONFIG_IOMMUFD=m
CONFIG_CRYPTO_USER_API_HASH=m

# Platform drivers the reference node loads: input, remote control core, DMI tables in
# sysfs, flash partitions and I2C multiplexers (selected by GPU drivers).
CONFIG_INPUT_JOYDEV=m
CONFIG_SERIO_RAW=m
CONFIG_RC_CORE=m
CONFIG_DMI_SYSFS=m
CONFIG_MTD=m
CONFIG_MTD_CMDLINE_PARTS=m
CONFIG_I2C_MUX=m
