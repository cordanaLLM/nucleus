# Lusoris mainstream stream: layered after the architecture fragment by merge-config.sh --stream=mainstream
# Kube-proxy in iptables mode and Cilium in iptables mode use the legacy iptables raw table;
# legacy xtables is needed here. Upstream makes it depend on !PREEMPT_RT (net/netfilter/Kconfig),
# so it sits in the non-realtime stream fragments rather than k8s-node.config.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_RAW=m

# BBRv3 (tcp_bbr3) from the bbr3 patch series (versions.json patches.bbr3, docs/patches.md), as a
# module beside BBRv1, which stays the default; the symbol exists only in a patched tree.
CONFIG_TCP_CONG_BBR3=m
