# Lusoris realtime stream: layered after the architecture fragment by merge-config.sh --stream=realtime
# Aegis REQ-P07-01 asks for PREEMPT_RT and HZ_1000 together, as one latency requirement.
# PREEMPT_RT depends on EXPERT && ARCH_SUPPORTS_RT && !COMPILE_TEST (kernel/Kconfig.preempt,
# Linux 7.2). x86, arm64 and riscv select ARCH_SUPPORTS_RT; EXPERT is set here, because
# without it olddefconfig drops PREEMPT_RT and the stream builds a non-realtime kernel.
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y

# Upstream makes legacy xtables depend on !PREEMPT_RT (net/netfilter/Kconfig), so a realtime
# node has no iptables legacy raw table; kube-proxy in nftables mode and Cilium in eBPF mode
# do not need it.

# BBRv3 (tcp_bbr3) from the bbr3 patch series (versions.json patches.bbr3, docs/patches.md), as a
# module beside BBRv1, which stays the default; the symbol exists only in a patched tree.
CONFIG_TCP_CONG_BBR3=m
