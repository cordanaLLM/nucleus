# Build outputs & packaging
output/
dist/
build/
site/
*.deb
*.ddeb
*.changes
*.buildinfo
*.dsc
*.tar.xz
*.tar.gz
*.orig.tar.gz

# Kernel source trees & compilation artifacts
linux-*/
*.o
*.ko
*.mod
*.mod.c
*.order
Module.symvers
modules.order
# Kernel build output, at any depth. The trailing-slash negation re-includes the
# directory of the same name so the praetor archetype catalog under
# .config/archetypes/ can be tracked; git cannot re-include paths inside an
# excluded directory, so the directory itself must not be excluded.
.config
.config.old
!.config/
*.cmd

# Python & testing caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
env/
venv/

# IDE & Editor artifacts
.vscode/
.idea/
*.swp
*~

# Worktrees & scratch
.workingdir2/
.scratch/

# Secrets & credentials
*.pem
*.key
*.token
.env
