{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>plurano/horistes",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScope(deps)",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "timezone": "UTC",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",
  "pip-compile": {
    "managerFilePatterns": ["/(^|/)requirements-test\\.txt$/"]
  },
  "pip_requirements": {
    "enabled": false
  },
  "pip_setup": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "groupSlug": "github-actions",
      "pinDigests": true
    },
    {
      "matchManagers": ["pip-compile", "setup-cfg", "pep621"],
      "groupName": "python-tooling",
      "groupSlug": "python-tooling"
    },
    {
      "matchDatasources": ["docker"],
      "groupName": "container-images",
      "groupSlug": "container-images"
    },
    {
      "matchFileNames": ["versions.json"],
      "semanticCommitScope": "versions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.json$/", "/^\\.github\\/workflows\\/.*\\.ya?ml$/"],
      "matchStrings": [
        "\"(?<depName>(?:registry\\.k8s\\.io|docker\\.io|quay\\.io|ghcr\\.io)[^:\"]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
